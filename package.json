{
  "name": "@calljacob/leaddocket-typescript",
  "version": "1.1.0",
  "description": "A strongly-typed API client library for Lead Docket, automatically generated from the official OpenAPI schema.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock/server": {
      "import": {
        "types": "./dist/mock/server.d.mts",
        "default": "./dist/mock/server.mjs"
      },
      "require": {
        "types": "./dist/mock/server.d.cts",
        "default": "./dist/mock/server.cjs"
      }
    },
    "./mock/faker": {
      "import": {
        "types": "./dist/mock/faker.d.mts",
        "default": "./dist/mock/faker.mjs"
      },
      "require": {
        "types": "./dist/mock/faker.d.cts",
        "default": "./dist/mock/faker.cjs"
      }
    }
  },
  "bin": {
    "leaddocket-mock": "./dist/mock/cli.cjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE.md",
    ".dev.vars.example",
    "examples",
    "leaddocket.mock.example.json"
  ],
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "vp pack",
    "test": "vp test",
    "build": "vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "sanitize:webhook-examples": "node scripts/sanitize-webhook-examples.mjs",
    "check:webhook-examples": "node scripts/sanitize-webhook-examples.mjs --check",
    "check:mock-metadata": "node scripts/check-mock-metadata.mjs",
    "check:package-contract": "node scripts/check-package-contract.mjs",
    "mock": "vp pack && node dist/mock/cli.cjs",
    "commitlint": "vite-plus-commitlint",
    "prepare": "vp config"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calljacob/leaddocket-typescript.git"
  },
  "keywords": [
    "leaddocket",
    "lead-docket",
    "api",
    "client",
    "typescript",
    "sdk",
    "openapi"
  ],
  "author": "bhubbard",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/calljacob/leaddocket-typescript/issues"
  },
  "homepage": "https://github.com/calljacob/leaddocket-typescript#readme",
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "swagger-ui-dist": "5.32.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vite-plus-commitlint": "^1.1.3"
  },
  "packageManager": "pnpm@11.20.0"
}
