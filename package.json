{
  "name": "@calljacob/leaddocket-typescript",
  "version": "1.1.0",
  "description": "A strongly-typed API client library for Lead Docket, automatically generated from the official OpenAPI schema.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "build": "tsup",
    "lint": "eslint .",
    "format": "prettier --write .",
    "commitlint": "vite-plus-commitlint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calljacob/leaddocket-typescript.git"
  },
  "keywords": [
    "leaddocket",
    "lead-docket",
    "api",
    "client",
    "typescript",
    "sdk",
    "openapi"
  ],
  "author": "bhubbard",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "bugs": {
    "url": "https://github.com/calljacob/leaddocket-typescript/issues"
  },
  "homepage": "https://github.com/calljacob/leaddocket-typescript#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite-plus": "^0.2.8",
    "vite-plus-commitlint": "^1.1.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
